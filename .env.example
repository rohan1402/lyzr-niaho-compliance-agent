# Lyzr Agent API key (from the Lyzr dashboard / the "Agent API" panel in Studio)
LYZR_AGENT_API_KEY=your_api_key_here

# Optional override: Studio KB id. agent_config.json already ships the live
# lyzr_rag.rag_id, so set this only to point a deploy at a different KB.
LYZR_KB_ID=

# Set after the first deploy to update the existing agent instead of creating a new one
LYZR_AGENT_ID=
